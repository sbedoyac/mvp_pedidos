# Copiar a .env y completar. NUNCA commitear el .env real.
# No incluir direcciones ni credenciales reales en este archivo.

# Credenciales contra sgc. Pueden ser una cuenta admin con permisos de escritura reales —
# la restricción de "solo lectura" NO depende de los permisos de MySQL, se aplica en código
# (ver src/sgc/db.ts: usar siempre sgcQuery/sgcQueryOne, nunca un pool directo).
SGC_DB_HOST=
SGC_DB_PORT=3306
SGC_DB_USER=
SGC_DB_PASSWORD=
SGC_DB_NAME=sgc

# Base de datos propia del MVP (sql.js / SQLite en archivo, ver src/db/sqlite.ts).
# Ruta relativa al cwd del proceso api (apps/api/ en dev, o donde se lance `node dist/server.js`).
MVP_DB_PATH=data/mvp_pedidos.sqlite3

PORT=4000
# Lista separada por comas. En producción es obligatoria y debe contener dominios exactos.
CORS_ORIGIN=http://localhost:5173
